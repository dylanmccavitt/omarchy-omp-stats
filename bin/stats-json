#!/usr/bin/env bash
set -uo pipefail

find_omp() {
  local candidate
  local mise_root

  if [[ -n ${OMP_BIN:-} ]]; then
    [[ -x $OMP_BIN ]] || return 1
    printf '%s\n' "$OMP_BIN"
    return 0
  fi

  candidate="$(command -v omp 2>/dev/null || true)"
  if [[ -n $candidate && -x $candidate ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if command -v mise >/dev/null 2>&1; then
    candidate="$(mise which omp 2>/dev/null || true)"
    if [[ -n $candidate && -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  mise_root="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
  for candidate in \
    "$mise_root/installs/github-can1357-oh-my-pi/latest/omp" \
    "$mise_root"/installs/github-can1357-oh-my-pi/*/omp; do
    if [[ -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

if ! omp_bin="$(find_omp)"; then
  printf '%s\n' "OMP Stats requires the omp CLI on PATH or installed through mise." >&2
  exit 127
fi

raw="$("$omp_bin" stats --json)"
status=$?
if (( status != 0 )); then
  printf 'OMP Stats could not run %s stats --json (exit %d).\n' "$omp_bin" "$status" >&2
  exit "$status"
fi

json="${raw#*\{}"
if [[ $json == "$raw" ]]; then
  printf '%s\n' "OMP Stats received no JSON object from omp stats --json." >&2
  exit 65
fi

printf '{%s\n' "$json"
